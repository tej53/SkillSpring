<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- Departments -->
    <bean id="dept1" class="com.cognizant.springlearn.model.Department">
        <property name="id" value="1"/>
        <property name="name" value="IT"/>
    </bean>
    <bean id="dept2" class="com.cognizant.springlearn.model.Department">
        <property name="id" value="2"/>
        <property name="name" value="Finance"/>
    </bean>
    <bean id="dept3" class="com.cognizant.springlearn.model.Department">
        <property name="id" value="3"/>
        <property name="name" value="HR"/>
    </bean>

    <!-- Skills -->
    <bean id="skill1" class="com.cognizant.springlearn.model.Skill">
        <property name="id" value="1"/>
        <property name="name" value="Java"/>
    </bean>
    <bean id="skill2" class="com.cognizant.springlearn.model.Skill">
        <property name="id" value="2"/>
        <property name="name" value="Angular"/>
    </bean>
    <bean id="skill3" class="com.cognizant.springlearn.model.Skill">
        <property name="id" value="3"/>
        <property name="name" value="Spring"/>
    </bean>
    <bean id="skill4" class="com.cognizant.springlearn.model.Skill">
        <property name="id" value="4"/>
        <property name="name" value="SQL"/>
    </bean>

    <!-- Employees -->
    <bean id="emp1" class="com.cognizant.springlearn.model.Employee">
        <property name="id" value="1"/>
        <property name="name" value="John Smith"/>
        <property name="salary" value="75000"/>
        <property name="permanent" value="true"/>
        <property name="dateOfBirth" value="15/06/1990"/>
        <property name="department" ref="dept1"/>
        <property name="skills">
            <list>
                <ref bean="skill1"/>
                <ref bean="skill3"/>
            </list>
        </property>
    </bean>

    <bean id="emp2" class="com.cognizant.springlearn.model.Employee">
        <property name="id" value="2"/>
        <property name="name" value="Jane Doe"/>
        <property name="salary" value="82000"/>
        <property name="permanent" value="true"/>
        <property name="dateOfBirth" value="22/03/1988"/>
        <property name="department" ref="dept2"/>
        <property name="skills">
            <list>
                <ref bean="skill2"/>
                <ref bean="skill4"/>
            </list>
        </property>
    </bean>

    <bean id="emp3" class="com.cognizant.springlearn.model.Employee">
        <property name="id" value="3"/>
        <property name="name" value="Mike Johnson"/>
        <property name="salary" value="68000"/>
        <property name="permanent" value="false"/>
        <property name="dateOfBirth" value="10/11/1992"/>
        <property name="department" ref="dept1"/>
        <property name="skills">
            <list>
                <ref bean="skill1"/>
                <ref bean="skill2"/>
                <ref bean="skill3"/>
            </list>
        </property>
    </bean>

    <bean id="emp4" class="com.cognizant.springlearn.model.Employee">
        <property name="id" value="4"/>
        <property name="name" value="Sarah Williams"/>
        <property name="salary" value="90000"/>
        <property name="permanent" value="true"/>
        <property name="dateOfBirth" value="05/09/1985"/>
        <property name="department" ref="dept3"/>
        <property name="skills">
            <list>
                <ref bean="skill3"/>
                <ref bean="skill4"/>
            </list>
        </property>
    </bean>

    <bean id="emp5" class="com.cognizant.springlearn.model.Employee">
        <property name="id" value="5"/>
        <property name="name" value="David Brown"/>
        <property name="salary" value="72000"/>
        <property name="permanent" value="false"/>
        <property name="dateOfBirth" value="28/01/1991"/>
        <property name="department" ref="dept2"/>
        <property name="skills">
            <list>
                <ref bean="skill1"/>
                <ref bean="skill4"/>
            </list>
        </property>
    </bean>

    <!-- Employee List -->
    <bean id="employeeList" class="java.util.ArrayList">
        <constructor-arg>
            <list>
                <ref bean="emp1"/>
                <ref bean="emp2"/>
                <ref bean="emp3"/>
                <ref bean="emp4"/>
                <ref bean="emp5"/>
            </list>
        </constructor-arg>
    </bean>

    <!-- Department List -->
    <bean id="departmentList" class="java.util.ArrayList">
        <constructor-arg>
            <list>
                <ref bean="dept1"/>
                <ref bean="dept2"/>
                <ref bean="dept3"/>
            </list>
        </constructor-arg>
    </bean>

</beans>
